# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# This file contains placeholders only.

APP_ENV=development                 # development | production (production refuses to start with placeholder secrets: see DEPLOY.md)
APP_HOST=127.0.0.1                  # production requires 127.0.0.1 (only Caddy may reach the app); used by python -m app.server
APP_PORT=8000
# Logging: stdout/journald always; set LOG_DIR to also write a rotating file. LOG_FORMAT: auto (json in production) | json | text
LOG_LEVEL=INFO
LOG_FORMAT=auto
LOG_DIR=

# Signs the login cookie. Needs 32+ characters. Create a real one automatically with:
#   python -m app.scripts.generate_secret
SESSION_SECRET=change-me
SESSION_COOKIE_SECURE=              # leave empty: on in production, off in development. true/false to force.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Encrypts the full Omang/passport numbers stored for employees. REQUIRED: the app will not start without it.
# Create it automatically (written into .env, never shown) with:  python -m app.scripts.generate_encryption_key
# Back it up somewhere safe: if it is lost, stored ID numbers cannot be read and must be imported again.
ID_ENCRYPTION_KEY=
# Only used while rotating the key (see README "Rotating the encryption key"). Leave empty otherwise.
ID_ENCRYPTION_KEY_PREVIOUS=
REVEAL_MAX_PER_MINUTE=10            # how often one admin may press "Show IDs" per minute

# MySQL / MariaDB
DATABASE_URL=mysql+pymysql://payslip_app:YOUR_DB_PASSWORD@127.0.0.1:3306/payslip_sender?charset=utf8mb4

# WhatsApp: "mock" = fake sends, no network (default). "live" = real Meta API.
WHATSAPP_MODE=mock
# In live mode, send an approved template ("template") or a plain document ("document", only works inside the 24h window)
WHATSAPP_SEND_KIND=template
WHATSAPP_TEMPLATE_NAME=payslip_
WHATSAPP_TEMPLATE_LANGUAGE=en
# Only for the preview on the send screen (never sent): the wording of your approved template. {{1}} = employee name, {{2}} = pay month.
WHATSAPP_TEMPLATE_PREVIEW_TEXT=Hello {{1}}, your payslip for {{2}} is attached. To open it, use the last 4 characters of your Omang or passport number as the password.
GRAPH_API_VERSION=v23.0             # check Meta's docs for the current version
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# The WhatsApp Business ACCOUNT id (a different number from the phone number id). Used only by the preflight check:
#   python -m app.scripts.check_live_config
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# Safety switch for live mode: comma-separated phone numbers like +26771234567,+26772345678. When set, live mode sends ONLY
# to these numbers (anyone else fails with a clear reason). Leave empty for no restriction. Strongly advised while testing.
WHATSAPP_ALLOWED_RECIPIENTS=
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_TIMEOUT_SECONDS=30
# Sending engine
SEND_CONCURRENCY=5                  # payslips sent at the same time (1 to 20)
SEND_INTERVAL_MS=200                # minimum gap between WhatsApp requests, all workers together (gentle rate limiting)
SEND_MAX_RETRIES=3                  # automatic retries for clear transient failures only (429, 5xx, cannot connect)

# Private folder for uploaded + encrypted PDFs (must NOT be inside a public/static folder)
PRIVATE_STORAGE_DIR=private_storage
MAX_UPLOAD_MB=10                    # max size of a single PDF
SENT_RETENTION_DAYS=7               # delete stored PDFs this many days after a batch finished sending (daily purge job)

# Payslip batches (upload and review)
MAX_FILES_PER_BATCH=300
MAX_BATCH_TOTAL_MB=200              # all PDFs of one batch together
MAX_UNZIPPED_MB=250                 # a ZIP may not expand to more than this (zip-bomb guard)
BATCH_RETENTION_DAYS=30             # python -m app.scripts.purge_old_batches deletes stored PDFs older than this

# Employee import
IMPORT_MAX_ROWS=2000
IMPORT_PREVIEW_MINUTES=15           # unconfirmed previews are discarded after this long

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
