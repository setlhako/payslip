# Production settings for Payslip Sender. setup-server.sh copies this to /opt/payslip-sender/.env (owner "payslip", mode 600) the first
# time, and fills in DATABASE_URL, SESSION_SECRET and ID_ENCRYPTION_KEY for you WITHOUT printing them.
# Never commit the real .env. Check it any time with:  sudo -u payslip /opt/payslip-sender/.venv/bin/python -m app.scripts.production_check
# Every setting is explained in /opt/payslip-sender/.env.example; only the ones that differ from development are listed here.

APP_ENV=production                  # debug off, /docs off, Secure cookies, refuses to start with placeholder secrets
APP_HOST=127.0.0.1                  # never change: only Caddy (HTTPS) may reach the app
APP_PORT=8000

# Filled in by setup-server.sh (do not type them here).
SESSION_SECRET=
ID_ENCRYPTION_KEY=
ID_ENCRYPTION_KEY_PREVIOUS=
DATABASE_URL=

# Logs go to journald (sudo journalctl -u payslip-sender) and to a rotating file in LOG_DIR. Format auto = JSON in production.
LOG_LEVEL=INFO
LOG_FORMAT=auto
LOG_DIR=/var/log/payslip-sender

# Start in MOCK mode: nothing real is sent until you have run the live preflight and the go-live checklist in DEPLOY.md.
WHATSAPP_MODE=mock
WHATSAPP_SEND_KIND=template
WHATSAPP_TEMPLATE_NAME=payslip_
WHATSAPP_TEMPLATE_LANGUAGE=en
GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# While testing live mode put YOUR OWN number here (+26771234567). Clear it only after one test batch reached you.
WHATSAPP_ALLOWED_RECIPIENTS=

# Uploaded PDFs live here (outside the code folder). Deleted SENT_RETENTION_DAYS after a batch finished sending (daily timer).
PRIVATE_STORAGE_DIR=/var/lib/payslip-sender/storage
SENT_RETENTION_DAYS=7
BATCH_RETENTION_DAYS=30
